# ==============================================================================
# CLOUD-BASED ERP FOR COLLEGES - BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and configure for your deployment environment.
# NEVER commit real credentials, passwords, or tokens to version control.
# ==============================================================================

# Application Environment ('development' or 'production')
ENVIRONMENT=development
APP_NAME="Cloud-Based ERP for Colleges"

# ------------------------------------------------------------------------------
# SUPABASE CLOUD DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Direct Connection (Port 5432):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
#
# Connection Pooler - Transaction Mode (Port 6543, Recommended for serverless/cloud):
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
#
# Local SQLite fallback is only permitted in development when DATABASE_URL is empty:
DATABASE_URL=

# ------------------------------------------------------------------------------
# SECURITY & AUTHENTICATION (JWT)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
SECRET_KEY=change-this-in-production-to-a-very-long-random-secret-key-32-bytes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# SMTP OUTBOUND EMAIL CONFIGURATION (For Automated Parent Attendance Alerts)
# ------------------------------------------------------------------------------
# Gmail Example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USERNAME=your-college-notifications@gmail.com
#   SMTP_PASSWORD=your-16-character-app-password (requires 2-Step Verification)
#   SMTP_USE_TLS=true
#
# Leave empty to run in Safe Diagnostic Mode (renders full HTML alerts & logs status):
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@college-erp.edu
SMTP_FROM_NAME="College Academic Office"
SMTP_USE_TLS=true

# ------------------------------------------------------------------------------
# ATTENDANCE RULES & ACADEMIC THRESHOLDS
# ------------------------------------------------------------------------------
SAFE_THRESHOLD=75.0
WARNING_THRESHOLD=65.0

# ------------------------------------------------------------------------------
# CORS & FRONTEND CLIENT
# ------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# GOOGLE GEMINI AI ASSISTANT CONFIGURATION
# ------------------------------------------------------------------------------
# Grounded RAG AI Assistant for attendance, recovery, fees, exams, and timetable.
# Obtain your free API key at: https://aistudio.google.com/app/apikey
# If left empty, system automatically operates with the deterministic ERP reasoning engine.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# OPTIONAL DEMO SEEDING
# ------------------------------------------------------------------------------
# Set to true ONLY to seed initial mock accounts in local development:
SEED_DEMO_DATA=false
